[TEMPLATE]
# Copy to apps/mobile/.env. Expo only exposes EXPO_PUBLIC_* to the client.
# Local API:
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Android emulator reaches the host machine at 10.0.2.2:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
# A real phone needs the laptop's LAN address, also listed in the API's CORS_ORIGINS:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
