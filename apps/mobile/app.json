{
  "expo": {
    "name": "Invoxa",
    "slug": "invoxa",
    "version": "1.0.0",
    "scheme": "invoxa",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.invoxa.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "app.invoxa.mobile",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-local-authentication",
        { "faceIDPermission": "Invoxa uses Face ID to unlock the app on this phone." }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
