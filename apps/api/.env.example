# Copy to apps/api/.env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas free cluster connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/invoxa

# At least 32 characters. The server refuses to boot without it.
JWT_SECRET=replace-with-at-least-32-characters

# Google AI Studio key and model (model name stays in env so it can change)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=30

# Comma-separated allowed origins for the web build. In production use the
# deployed web origin only, with https.
CORS_ORIGINS=http://localhost:8081

# General requests a minute per user or IP, and sign-in attempts per IP.
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

# Secret header for scheduled job endpoints (POST /recurring/run)
JOB_SECRET=replace-with-a-random-string
